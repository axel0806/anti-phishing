SERVER_SECRET=
TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_PASSWORD=
# Optional:
# DATABASE_URL=postgres://phish:phish@localhost:5432/phish
# PORT=8080
# ROLE=all
# POLL_SECONDS=60

# AI layer (optional). Users still opt in individually; nothing is sent until they do.
# AI_PROVIDER=none            # none | anthropic | openai (openai = any OpenAI-compatible server, e.g. local Ollama)
# ANTHROPIC_API_KEY=
# AI_MODEL=                   # default for anthropic: claude-haiku-5-5
# AI_PRICE_IN_PER_MTOK=       # required for anthropic: USD per million input tokens (for budgets)
# AI_PRICE_OUT_PER_MTOK=      # required for anthropic: USD per million output tokens
# AI_BASE_URL=http://localhost:11434/v1   # for AI_PROVIDER=openai
# AI_API_KEY=
# AI_TIMEOUT_MS=2500
# AI_MAX_USER_BUDGET_USD=20     # hard cap on any one user's monthly AI spend, whatever they set
