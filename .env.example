SERVER_SECRET=
TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_PASSWORD=
# Optional:
# DATABASE_URL=postgres://phish:phish@localhost:5432/phish
# PORT=8080
# ROLE=all
# POLL_SECONDS=60

# AI layer (optional). Users still opt in individually; nothing is sent until they do.
# AI_PROVIDER=none            # none | anthropic | openai (openai = any OpenAI-compatible server, e.g. local Ollama)
# ANTHROPIC_API_KEY=
# AI_MODEL=                   # default for anthropic: claude-haiku-5-5
# AI_PRICE_IN_PER_MTOK=       # required for anthropic: USD per million input tokens (for budgets)
# AI_PRICE_OUT_PER_MTOK=      # required for anthropic: USD per million output tokens
# AI_BASE_URL=http://localhost:11434/v1   # for AI_PROVIDER=openai
# AI_API_KEY=
# AI_TIMEOUT_MS=2500
# AI_MAX_USER_BUDGET_USD=20     # hard cap on any one user's monthly AI spend, whatever they set

# Phase 4 (all optional)
# PUBLIC_URL=https://phish.example.com   # https URL users reach this server at; needed for SSO redirects and the Outlook manifest
# MICROSOFT_CLIENT_ID=                    # Outlook / Microsoft 365 mailboxes (Graph)
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common                 # tenant id, domain, or common/organizations/consumers
# OIDC_ISSUER=https://login.example.com   # single sign-on for /admin/ (users must already exist with a role)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_TRUST_MISSING_EMAIL_VERIFIED=true  # ONLY with a single-tenant issuer. On a multi-tenant one (Entra "common") another tenant can assert any email and sign in as that user
# RDAP_LOOKUPS=true                       # domain-age lookups (sends sender domains to public RDAP servers)
# SAFE_BROWSING_API_KEY=                  # Google Safe Browsing link checks. Sends each link as scheme+host+PATH (no query or fragment) to Google; paths can contain tokens

# METRICS_TOKEN=                          # lets a scraper read /metrics from outside localhost
# SETUP_TOKEN=                           # optional, 16+ chars; unlocks /setup (first admin in the browser). Generated and printed at startup if unset. See docs/ONBOARDING.md
