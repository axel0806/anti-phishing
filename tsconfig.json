{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "noEmit": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src", "packages/*/test", "corpus"]
}
